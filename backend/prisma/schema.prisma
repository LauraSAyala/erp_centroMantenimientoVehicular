generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model cliente {
  id_cliente     Int              @id @default(autoincrement())
  identificacion String           @unique @db.VarChar(20)
  nombre         String           @db.VarChar(80)
  apellido       String           @db.VarChar(80)
  telefono       String?          @db.VarChar(20)
  email          String?          @db.VarChar(120)
  fecha_creacion DateTime         @default(now()) @db.Timestamptz(6)
  orden_servicio orden_servicio[]
  vehiculo       vehiculo[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model detalle_orden_producto {
  id_detalle        Int            @id @default(autoincrement())
  id_orden_servicio Int
  id_producto       Int
  cantidad          Decimal        @db.Decimal(10, 2)
  precio_unitario   Decimal        @db.Decimal(12, 2)
  subtotal          Decimal?       @default(dbgenerated("(cantidad * precio_unitario)")) @db.Decimal(14, 2)
  orden_servicio    orden_servicio @relation(fields: [id_orden_servicio], references: [id_orden_servicio], onDelete: Cascade, onUpdate: NoAction)
  producto          producto       @relation(fields: [id_producto], references: [id_producto], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id_orden_servicio, id_producto], map: "uq_detalle_orden_producto")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model movimiento_inventario {
  id_movimiento     Int             @id @default(autoincrement())
  id_producto       Int
  tipo              tipo_movimiento
  cantidad          Decimal         @db.Decimal(10, 2)
  id_orden_servicio Int?
  id_usuario        Int
  fecha             DateTime        @default(now()) @db.Timestamptz(6)
  nota              String?         @db.VarChar(255)
  orden_servicio    orden_servicio? @relation(fields: [id_orden_servicio], references: [id_orden_servicio], onDelete: NoAction, onUpdate: NoAction)
  producto          producto        @relation(fields: [id_producto], references: [id_producto], onDelete: NoAction, onUpdate: NoAction)
  usuario           usuario         @relation(fields: [id_usuario], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)

  @@index([id_producto, fecha], map: "idx_movimiento_producto_fecha")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model orden_servicio {
  id_orden_servicio                           Int                      @id @default(autoincrement())
  id_sede                                     Int
  id_cliente                                  Int
  id_vehiculo                                 Int
  id_mecanico                                 Int
  id_lider                                    Int
  id_cajero                                   Int?
  descripcion                                 String
  kilometraje_ingreso                         Decimal                  @db.Decimal(10, 1)
  tiempo_asignado_min                         Int
  fecha_creacion                              DateTime                 @default(now()) @db.Timestamptz(6)
  hora_inicio                                 DateTime?                @db.Timestamptz(6)
  hora_fin                                    DateTime?                @db.Timestamptz(6)
  tiempo_real_min                             Int?
  estado                                      estado_orden             @default(pendiente)
  valor_servicio                              Decimal?                 @db.Decimal(12, 2)
  valor_productos                             Decimal?                 @db.Decimal(12, 2)
  valor_total                                 Decimal?                 @db.Decimal(12, 2)
  fecha_cierre                                DateTime?                @db.Timestamptz(6)
  motivo_anulacion                            String?                  @db.VarChar(255)
  detalle_orden_producto                      detalle_orden_producto[]
  movimiento_inventario                       movimiento_inventario[]
  usuario_orden_servicio_id_cajeroTousuario   usuario?                 @relation("orden_servicio_id_cajeroTousuario", fields: [id_cajero], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
  cliente                                     cliente                  @relation(fields: [id_cliente], references: [id_cliente], onDelete: NoAction, onUpdate: NoAction)
  usuario_orden_servicio_id_liderTousuario    usuario                  @relation("orden_servicio_id_liderTousuario", fields: [id_lider], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
  usuario_orden_servicio_id_mecanicoTousuario usuario                  @relation("orden_servicio_id_mecanicoTousuario", fields: [id_mecanico], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
  sede                                        sede                     @relation(fields: [id_sede], references: [id_sede], onDelete: NoAction, onUpdate: NoAction)
  vehiculo                                    vehiculo                 @relation(fields: [id_vehiculo], references: [id_vehiculo], onDelete: NoAction, onUpdate: NoAction)

  @@index([fecha_creacion], map: "idx_orden_fecha_creacion")
  @@index([hora_inicio], map: "idx_orden_hora_inicio")
  @@index([id_mecanico, estado], map: "idx_orden_mecanico_estado")
  @@index([id_sede, estado], map: "idx_orden_sede_estado")
  @@index([id_vehiculo], map: "idx_orden_vehiculo")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model producto {
  id_producto            Int                      @id @default(autoincrement())
  id_sede                Int
  nombre_producto        String                   @db.VarChar(120)
  descripcion            String?                  @db.VarChar(255)
  stock                  Decimal                  @db.Decimal(10, 2)
  precio_unitario        Decimal                  @db.Decimal(12, 2)
  activo                 Boolean                  @default(true)
  detalle_orden_producto detalle_orden_producto[]
  movimiento_inventario  movimiento_inventario[]
  sede                   sede                     @relation(fields: [id_sede], references: [id_sede], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id_sede, nombre_producto], map: "uq_producto_sede_nombre")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model sede {
  id_sede        Int              @id @default(autoincrement())
  ciudad         String           @db.VarChar(80)
  direccion      String           @db.VarChar(150)
  telefono       String?          @db.VarChar(20)
  activo         Boolean          @default(true)
  orden_servicio orden_servicio[]
  producto       producto[]
  usuario        usuario[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model usuario {
  id_usuario                                         Int                     @id @default(autoincrement())
  nombre                                             String                  @db.VarChar(80)
  apellido                                           String                  @db.VarChar(80)
  identificacion                                     String                  @unique @db.VarChar(20)
  email                                              String                  @unique @db.VarChar(120)
  telefono                                           String?                 @db.VarChar(20)
  password_hash                                      String                  @db.VarChar(255)
  rol                                                rol_usuario
  id_sede                                            Int?
  debe_cambiar_password                              Boolean                 @default(true)
  activo                                             Boolean                 @default(true)
  fecha_creacion                                     DateTime                @default(now()) @db.Timestamptz(6)
  movimiento_inventario                              movimiento_inventario[]
  orden_servicio_orden_servicio_id_cajeroTousuario   orden_servicio[]        @relation("orden_servicio_id_cajeroTousuario")
  orden_servicio_orden_servicio_id_liderTousuario    orden_servicio[]        @relation("orden_servicio_id_liderTousuario")
  orden_servicio_orden_servicio_id_mecanicoTousuario orden_servicio[]        @relation("orden_servicio_id_mecanicoTousuario")
  sede                                               sede?                   @relation(fields: [id_sede], references: [id_sede], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model vehiculo {
  id_vehiculo    Int              @id @default(autoincrement())
  placa          String           @unique @db.VarChar(10)
  tipo_vehiculo  tipo_vehiculo
  kilometraje    Decimal          @db.Decimal(10, 1)
  id_cliente     Int
  orden_servicio orden_servicio[]
  cliente        cliente          @relation(fields: [id_cliente], references: [id_cliente], onDelete: NoAction, onUpdate: NoAction)
}

enum estado_orden {
  pendiente
  en_proceso
  finalizada
  cerrada
  anulada
}

enum rol_usuario {
  administrador
  lider_area
  mecanico
  cajero
}

enum tipo_movimiento {
  entrada
  salida_orden
  devolucion_anulacion
  ajuste
}

enum tipo_vehiculo {
  carro
  moto
  camion
}
